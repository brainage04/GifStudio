---
import ShellLayout from '@brainage04/astro-shell/components/SiteLayout.astro';
import { base } from 'astro:config/client';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Browser-based GIF overlay renderer by brainage04.' } = Astro.props;
const faviconHref = `${base.replace(/\/$/, '')}/assets/overlays/brainage.jpg`;
const navItems = [
  { name: 'GifStudio', href: base, match: base, activeMode: 'exact' as const },
  { name: 'Main site', href: 'https://brainage04.github.io/', external: true },
] as const;
---

<ShellLayout
  title={title}
  siteName="GifStudio"
  homeTitle="GifStudio"
  navItems={navItems}
  sourceHref="https://github.com/brainage04/GifStudio"
  description={description}
  faviconHref={faviconHref}
  faviconType="image/jpeg"
>
  <slot />
</ShellLayout>
