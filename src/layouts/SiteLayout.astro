---
import ShellLayout from '@brainage04/astro-shell/components/SiteLayout.astro';
import '../styles/site.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Browser-based GIF overlay renderer by brainage04.' } = Astro.props;
const navItems = [
  { name: 'GifStudio', href: '/', match: '/', activeMode: 'exact' as const },
  { name: 'Main site', href: 'https://brainage04.github.io/', external: true },
] as const;
---

<ShellLayout
  title={title}
  siteName="GifStudio"
  homeTitle="GifStudio"
  navItems={navItems}
  sourceHref="https://github.com/brainage04/GifStudio"
  description={description}
  faviconHref="/assets/overlays/brainage.jpg"
  faviconType="image/jpeg"
  image="/assets/overlays/brainage.jpg"
  themeColor="#171218"
>
  <slot />
</ShellLayout>
