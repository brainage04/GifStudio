---
import { base } from 'astro:config/client';

const pathname = Astro.url.pathname;
const isActive = pathname === base;
---

<header class="site-header">
  <nav aria-label="Primary navigation">
    <div class="nav-links">
      <a href={base} aria-current={isActive ? 'page' : undefined} data-active={isActive ? 'true' : undefined}>GifStudio</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 5;
    background: var(--background0);
    border-block-end: 1px solid var(--border-subtle);
  }

  nav {
    width: min(100% - 3rem, var(--site-main-width));
    margin-inline: auto;
    display: flex;
    justify-content: center;
    padding-block: clamp(0.8rem, 1.6vw, 1rem);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem clamp(1.55rem, 4vw, 2.7rem);
    align-items: center;
  }

  .nav-links a {
    color: var(--foreground1);
    text-decoration: none;
    border-block-end: 2px solid transparent;
    padding-block: 0.2rem;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .nav-links a:hover,
  .nav-links a[data-active='true'] {
    color: var(--foreground0);
    border-block-end-color: var(--accent-cyan);
  }

  @media (max-width: 520px) {
    nav {
      align-items: flex-start;
    }

    .nav-links {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
