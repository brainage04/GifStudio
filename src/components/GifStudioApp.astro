---
import TerminalPanel from '@brainage04/astro-shell/components/TerminalPanel.astro';
import { withBase } from '@brainage04/astro-shell/withBase';
import { Image } from 'astro:assets';
import baseGif from '../assets/base/woman_is_talking.gif';
import { MAX_OVERLAY_SCALE } from '../lib/placement';

const overlayImage = withBase('/pfp.webp');
// The default overlay is 400px square; the script resets the limit to each overlay's own size.
const overlayMax = 400 * MAX_OVERLAY_SCALE;
---

<div class="studio-grid">
  <div class="studio-assets">
    <TerminalPanel title="Base GIF or image" class="asset-panel">
      <div class="panel-copy">
        <div
          class="dropzone combo-dropzone"
          id="base-dropzone"
          role="group"
          aria-label="Load base GIF or image from file or URL"
        >
          <label class="dropzone-prompt" for="base-file-input">
            <span><strong>Drop or paste a GIF or image</strong>or click to choose a base animation or still.</span>
            <input
              class="sr-only"
              id="base-file-input"
              type="file"
              accept=".gif,.png,.jpg,.jpeg,.webp,image/gif,image/png,image/jpeg,image/webp"
            />
          </label>

          <div class="url-loader" role="group" aria-label="Load base GIF or image from URL">
            <label class="field" for="base-url-input">
              Base GIF or image URL
              <input
                id="base-url-input"
                type="url"
                inputmode="url"
                autocomplete="off"
                placeholder="https://example.com/base.gif"
              />
            </label>
            <button class="action-button" id="base-url-load-button" type="button">Load</button>
          </div>
        </div>

        <p class="selected-file" id="base-selected-file" aria-live="polite">Using default base GIF.</p>
        <div class="preview-frame">
          {/* Animated WebP came out twice the GIF's size, so the optimised copy stays a GIF. */}
          <Image
            id="base-preview-image"
            src={baseGif}
            format="gif"
            alt="Preview of the selected base"
            loading="eager"
          />
        </div>
      </div>
    </TerminalPanel>

    <TerminalPanel title="Overlay GIF or image" class="asset-panel">
      <div class="panel-copy">
        <div
          class="dropzone combo-dropzone"
          id="dropzone"
          role="group"
          aria-label="Load overlay GIF or image from file or URL"
        >
          <label class="dropzone-prompt" for="file-input">
            <span
              ><strong>Drop or paste a GIF or image</strong>or click to choose a PNG, JPEG, GIF, or WebP overlay.</span
            >
            <input
              class="sr-only"
              id="file-input"
              type="file"
              accept=".webp,.png,.jpg,.jpeg,.gif,image/webp,image/png,image/jpeg,image/gif"
            />
          </label>

          <div class="url-loader" role="group" aria-label="Load overlay GIF or image from URL">
            <label class="field" for="overlay-url-input">
              Overlay GIF or image URL
              <input
                id="overlay-url-input"
                type="url"
                inputmode="url"
                autocomplete="off"
                placeholder="https://example.com/overlay.png"
              />
            </label>
            <button class="action-button" id="overlay-url-load-button" type="button">Load</button>
          </div>
        </div>

        <p class="selected-file" id="selected-file" aria-live="polite">Using default overlay image.</p>
        <div class="preview-frame overlay-preview" id="overlay-preview" hidden>
          <div class="crop-stage" id="overlay-crop-stage">
            {
              /* Shows the reader's own file from a blob: URL, which <Image> cannot process; the marker tells Astro's dev audit so. */
            }
            <img
              id="overlay-preview-image"
              data-image-component="true"
              src={overlayImage}
              alt="Selected overlay preview"
              width="400"
              height="400"
              draggable="false"
            />
            <div class="crop-box" id="overlay-crop-box" hidden></div>
          </div>
        </div>
        <p class="crop-hint">
          Drag the box or its handles to adjust cropping. Holding Shift maintains the aspect ratio of the crop.
        </p>
      </div>
    </TerminalPanel>
  </div>

  <TerminalPanel title="Editor" class="editor-panel">
    <div class="preview-frame overlay-editor" id="overlay-editor">
      <div class="placement-stage" id="placement-stage">
        <Image
          class="stage-base"
          id="stage-base"
          src={baseGif}
          format="gif"
          alt="Selected base in the placement editor"
          draggable="false"
        />
        <div class="stage-overlay" id="stage-overlay" hidden>
          <div class="box-clip">
            {/* Same blob: URL as the overlay preview above. */}
            <img
              id="overlay-image"
              data-image-component="true"
              src={overlayImage}
              alt="Overlay placement preview"
              width="400"
              height="400"
              draggable="false"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="controls" role="group" aria-label="Overlay placement controls">
      <label for="x-input">
        X
        <input id="x-input" type="number" step="1" value="58" />
      </label>
      <label for="y-input">
        Y
        <input id="y-input" type="number" step="1" value="0" />
      </label>
      <label for="width-input">
        Width
        <input id="width-input" type="number" min="1" max={overlayMax} step="1" value="120" />
      </label>
      <label for="height-input">
        Height
        <input id="height-input" type="number" min="1" max={overlayMax} step="1" value="120" />
      </label>
    </div>

    <div class="panel-actions editor-actions">
      <label class="handle-toggle" for="handles-toggle">
        <input id="handles-toggle" type="checkbox" checked />
        Resize handles
      </label>
      <button
        class="action-button download-button disabled"
        id="download-button"
        type="button"
        aria-disabled="true"
        disabled>Download GIF</button
      >
      <a id="download-link" hidden aria-hidden="true" tabindex="-1"></a>
    </div>

    <p class="status" id="status" aria-live="polite" hidden></p>
  </TerminalPanel>
</div>

<script src="../scripts/gifStudio.ts"></script>
